# Copy this file to .env and fill in real values before deploying.
# Never commit .env to git — it's already in .gitignore.

# Where SQLite writes its database file inside the container.
# The path /opt/app/data matches the WORKDIR volume mount in the Dockerfile.
SPRING_DATASOURCE_URL=jdbc:sqlite:/opt/app/data/todo.db

# Secret key used to sign and verify JWT tokens.
# Generate one at https://jwtsecretkeygenerator.com/ — must be base64-encoded.
SECURITY_JWT_SECRET_KEY=replace-with-your-base64-encoded-secret-key

# How long a JWT stays valid, in milliseconds.
# 3600000 = 1 hour. 86400000 = 24 hours.
SECURITY_JWT_EXPIRATION_TIME=3600000

# The frontend origin allowed to make cross-origin requests to this API.
# Set this to your S3 static site URL once Dev 1 shares it.
# Example: http://theblind-todo-frontend.s3-website-us-east-1.amazonaws.com
CORS_ALLOWED_ORIGINS=http://localhost:4200
