# Copy this file to .env and fill in the real values before you deploy.
# Do not commit .env to git. It is already listed in .gitignore.

# This tells the app where to find the SQLite database file inside the container.
# The path /opt/app/data is the folder the Dockerfile sets up for persistent storage.
SPRING_DATASOURCE_URL=jdbc:sqlite:/opt/app/data/todo.db

# This is the secret key used to sign and verify JWT tokens.
# You can generate one at https://jwtsecretkeygenerator.com
# It needs to be base64 encoded.
SECURITY_JWT_SECRET_KEY=replace-with-your-base64-encoded-secret-key

# How long a login token stays valid, measured in milliseconds.
# 3600000 is one hour. 86400000 is 24 hours.
SECURITY_JWT_EXPIRATION_TIME=3600000

# This is the frontend URL that is allowed to make requests to the API.
# It is set to the S3 bucket URL where the Angular app is hosted.
CORS_ALLOWED_ORIGINS=http://todo-app-storage-jam98.s3-website-us-east-1.amazonaws.com
