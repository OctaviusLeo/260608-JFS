# Copy this file to .env and fill in your own values before running docker compose.
# The .env file is gitignored so your secrets never get committed.

# Path to the SQLite database file inside the container
SPRING_DATASOURCE_URL=jdbc:sqlite:/opt/app/data/todo.db

# Secret key used to sign JWT tokens — swap this out for something random
# You can generate one with: openssl rand -base64 32
SECURITY_JWT_SECRET_KEY=replace-me-with-a-real-secret

# How long a token stays valid, in milliseconds (3600000 = 1 hour)
SECURITY_JWT_EXPIRATION_TIME=3600000
